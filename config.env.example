# Copy to config.env and edit locally. Never commit config.env.
export PROJECT_DIR="/path/to/metagenome_project"
export SAMPLES_TSV="${PROJECT_DIR}/metadata/samples.tsv"
export THREADS=48
export MAX_JOBS=4
export DRY_RUN=1

export KOFAM_EXEC="/path/to/kofam_scan/exec_annotation"
export KOFAM_PROFILES="/path/to/kofam/profiles"
export KOFAM_KO_LIST="/path/to/kofam/ko_list"

export PFAM00384_HMM="${PROJECT_DIR}/references/PF00384.hmm"
export RIESKE_PF00355_HMM="${PROJECT_DIR}/references/PF00355.hmm"
export DIHAEM_PF03150_HMM="${PROJECT_DIR}/references/PF03150.hmm"

